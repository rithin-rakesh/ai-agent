# Supabase Configuration
# Replace with your actual project URL and API keys from Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Application Configuration
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# JobSpy MCP Configuration
JOBSPY_ENABLED=true
JOBSPY_HOST=127.0.0.1
JOBSPY_PORT=9423
JOBSPY_TIMEOUT_SECONDS=120

# Candidate Profile Configuration
CANDIDATE_PROFILE_PATH=data/profile/candidate_profile.json

# NVIDIA AI Configuration (Phase 4 Semantic Matching)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_REASONING_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
SEMANTIC_MATCHING_ENABLED=true
DETERMINISTIC_SEMANTIC_THRESHOLD=60.0

# Apify Configuration (Glassdoor Discovery Actor)
APIFY_API_TOKEN=your-apify-api-token-here

# Browser Automation Configuration (Phase 5 Playwright Foundation)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_TRACE=false
INDEED_BROWSER_PROFILE_PATH=browser_sessions/indeed
SCREENSHOTS_PATH=screenshots
PLAYWRIGHT_ARTIFACTS_PATH=playwright-artifacts

# LinkedIn Outreach Agent Configuration (Phase 6.2)
LINKEDIN_OUTREACH_ENABLED=true
LINKEDIN_POST_SEARCH_ACTOR_ID=harvestapi~linkedin-post-search
LINKEDIN_PROFILE_POSTS_ACTOR_ID=harvestapi~linkedin-profile-posts
LINKEDIN_MAX_POSTS_PER_RUN=10
LINKEDIN_MAX_APIFY_RUNS_PER_DAY=5
LINKEDIN_MAX_LEADS_PER_RUN=10
LINKEDIN_MAX_DRAFTS_PER_RUN=5
LINKEDIN_MAX_FUTURE_SENDS_PER_DAY=10
RESUME_PDF_PATH=data/profile/resume.pdf
OUTREACH_AUTO_SEND=false
LINKEDIN_KEYWORDS_CONFIG_PATH=data/linkedin_keywords.json

